# Vercel server-side configuration. Never prefix either value with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_DEMO_KEY=replace-with-a-server-side-demo-key

# Temporary compatibility fallback when a restricted demo key is unavailable.
# SUPABASE_SECRET_KEY=replace-with-your-server-side-secret-key

# Required when generated event-card thumbnails are present.
CLOUDFLARE_ACCOUNT_ID=replace-with-your-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-a-read-only-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-a-read-only-r2-secret-key
R2_BUCKET_NAME=replace-with-your-demo-asset-bucket
# R2_S3_API_ENDPOINT=https://account-id.r2.cloudflarestorage.com

# Optional browser-visible API base path. Defaults to same-origin /api/lab.
VITE_DOT_GOV_API_BASE_URL=/api/lab

# Local Vite development proxy. These are not included in browser JavaScript.
DOT_GOV_API_PROXY_TARGET=http://127.0.0.1:4173
# DOT_GOV_API_TOKEN=replace-with-the-local-operator-token
# DOT_GOV_API_SESSION_COOKIE=replace-with-the-local-dashboard-session
