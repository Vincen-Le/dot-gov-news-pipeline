{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dot-gov-news-pipeline-dev",
  "main": "src/index.ts",
  "account_id": "a2d6c849c1770d0e7e4fc042db14de25",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "BUILD_VERSION": "bootstrap-v1",
    "DISCOVERY_CLAIM_LIMIT": "10",
    "DISCOVERY_CONTACT": "vincen_le@berkeley.edu",
    "DISCOVERY_ENABLED": "false",
    "DISCOVERY_LEASE_SECONDS": "900",
    "DISCOVERY_MAX_DELAY_SECONDS": "30",
    "DISCOVERY_MAX_PUBLISHER_REQUESTS": "36",
    "DISCOVERY_POLICY_VERSION": "1",
    "DISCOVERY_QUEUE_HIGH_WATER": "20",
    "DISCOVERY_SITE_DEADLINE_SECONDS": "600",
    "SUPABASE_URL": "https://qdqmahimrnwhzdjlcont.supabase.co",
  },
  "secrets": {
    "required": ["SUPABASE_SECRET_KEY"],
  },
  "triggers": {
    "crons": ["0 * * * *", "* * * * *"],
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "dot-gov-news-artifacts-dev",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "PIPELINE_EVENTS_QUEUE",
        "queue": "dot-gov-news-events-dev",
      },
      {
        "binding": "SITE_DISCOVERY_QUEUE",
        "queue": "dot-gov-site-discovery-dev",
      },
    ],
    "consumers": [
      {
        "queue": "dot-gov-news-events-dev",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "dot-gov-news-events-dlq-dev",
      },
      {
        "queue": "dot-gov-site-discovery-dev",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 10,
        "dead_letter_queue": "dot-gov-site-discovery-dlq-dev",
      },
    ],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
