{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dot-gov-news-operator-api-dev",
  "main": "src/index.ts",
  "account_id": "a2d6c849c1770d0e7e4fc042db14de25",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "BUILD_VERSION": "operator-api-v1",
    "ENVIRONMENT": "development",
    "OPS_API_ENABLED": "false",
    "SUPABASE_URL": "https://qdqmahimrnwhzdjlcont.supabase.co",
  },
  "secrets": {
    "required": ["OPS_API_TOKEN", "SUPABASE_SECRET_KEY"],
  },
  "services": [
    {
      "binding": "PIPELINE_WORKER",
      "service": "dot-gov-news-pipeline-dev",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "dot-gov-news-artifacts-dev",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "MAIN_QUEUE",
        "queue": "dot-gov-news-events-dev",
      },
      {
        "binding": "MAIN_DLQ",
        "queue": "dot-gov-news-events-dlq-dev",
      },
    ],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
