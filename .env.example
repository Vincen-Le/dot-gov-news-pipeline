# Copy this file to .env and fill in the values locally.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dot-gov-news-artifacts-dev
# Optional; derived from CLOUDFLARE_ACCOUNT_ID when omitted.
R2_S3_API_ENDPOINT=
# Local operator console. `pnpm ops:setup` fills these values automatically.
OPS_API_URL=https://dot-gov-news-operator-api-dev.example.workers.dev
OPS_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
OPS_WORKER_NAME=dot-gov-news-pipeline-dev
OPS_ENVIRONMENT=development
# Clustering lab (operator console). Same key the Python pipeline reads.
# Optional for `pnpm ops` — the console defaults to the local bench db below
# (the port supabase/config.toml pins) and passes it to spawned pipeline
# stages. Set it to target a different database, and export it in your shell
# for direct `python -m pipeline.cli` invocations.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:57422/postgres
